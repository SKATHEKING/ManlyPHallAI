# Environment Variables (Optional)

# Debug mode
DEBUG=false

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM
OLLAMA_MODEL=llama2:7b
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval
RETRIEVAL_K=5
RELEVANCE_THRESHOLD=0.5

# Note: Copy this file to .env and customize as needed
# Most values have sensible defaults in config.py
